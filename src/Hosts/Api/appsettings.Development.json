{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.OpenSearch",
      "Serilog.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "OpenSearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "smartledger-api-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "batchPostingLimit": 50,
          "period": 2,
          "inlineFields": true,
          "minimumLogEventLevel": "Information",
          "connectionTimeout": 5,
          "emitEventFailure": "WriteToSelfLog",
          "queueSizeLimit": 100000
        }
      },
      {
        "Name": "OpenSearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "efcore-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "batchPostingLimit": 50,
          "period": 2,
          "inlineFields": true,
          "minimumLogEventLevel": "Information",
          "connectionTimeout": 5,
          "emitEventFailure": "WriteToSelfLog",
          "queueSizeLimit": 100000,
          "filter": {
            "Name": "ByIncluding",
            "Args": {
              "expression": "StartsWith(SourceContext, 'Microsoft.EntityFrameworkCore')"
            }
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId",
      "WithEnvironmentUserName"
    ],
    "Properties": {
      "Application": "SmartLedger.Api",
      "Environment": "Development"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=smartledger_main;Username=postgres;Password=p4ssw0rd;ApplicationName=smart-ledger-api",
    "BankAccounts": "Host=localhost;Port=5434;Database=bank_accounts;Username=postgres;Password=p4ssw0rd;ApplicationName=smart-ledger-api",
